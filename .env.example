# =============================================================================
# Ezike Oba -- environment template
#
# Copy to .env.local and fill in real values:
#   cp .env.example .env.local
#
# .env.local is git-ignored. NEVER commit real keys.
# Values are validated at startup by src/lib/env.ts and src/lib/env.server.ts;
# a missing or malformed value fails loudly instead of failing at runtime.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase -- PUBLIC
# Safe to expose to the browser. The anon key is designed to be public: every
# request it makes is constrained by Row Level Security.
# Find both under: Supabase dashboard > Project Settings > API
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# -----------------------------------------------------------------------------
# Site URL
# Used for auth email redirect links and metadata canonical URLs.
# Local:      http://localhost:3000
# Production: https://your-domain.com   (no trailing slash)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Supabase -- SECRET
#
# !! DANGER !!
# The service-role key BYPASSES Row Level Security entirely. Anyone holding it
# can read and write every row in the database, including private data.
#
#   * Never prefix it with NEXT_PUBLIC_.
#   * Never import it from a Client Component (src/lib/env.server.ts carries a
#     `server-only` guard that makes this a build error).
#   * Never commit it.
#   * In Vercel, add it as an environment variable, not in code.
#
# Optional: only needed for privileged server tasks such as seeding or
# backfills. Ordinary request handling must use the request-scoped client so
# RLS still applies.
# -----------------------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
