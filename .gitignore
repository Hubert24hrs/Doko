# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files -- never commit real secrets
.env
.env.*
# ...but the template MUST be committed so setup is reproducible
!.env.example

# supabase local state
/supabase/.branches
/supabase/.temp

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# scratch/debug artifacts
/.probe/

